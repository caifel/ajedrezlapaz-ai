---
import Layout from '../layouts/Layout.astro';
import directiva from '../data/directiva.json';
---

<Layout
    title="Asociación Departamental de Ajedrez de La Paz (ADALP)"
    description="Sitio oficial de la Asociación Departamental de Ajedrez de La Paz (ADALP), fundada en 1929. Consulta jugadores, categorías y certificados oficiales."
>
    <style is:global>
        header .header-logo img { height: 35px; }

        /* HERO */
        #hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 120px 20px 80px;
            text-align: center;
        }

        .hero-logo-container { width: 180px; margin-bottom: 25px; }
        .hero-logo-container img { width: 100%; height: auto; display: block; }

        #hero h1 {
            font-size: 3.5rem;
            font-weight: 700;
            letter-spacing: 0.35em;
            margin-left: 0.35em;
            margin-bottom: 10px;
        }

        #hero h2 {
            font-size: 0.85rem;
            font-weight: 400;
            letter-spacing: 0.25em;
            margin-left: 0.25em;
            margin-bottom: 25px;
            text-transform: uppercase;
            max-width: 600px;
        }

        .divider {
            width: 60px;
            height: 2px;
            background-color: var(--color-accent);
            margin: 0 auto 25px auto;
        }

        .founding-date {
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            margin-left: 0.2em;
            color: var(--color-text-light);
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .institutional-text {
            font-size: 0.9rem;
            font-weight: 300;
            color: var(--color-text-light);
            max-width: 600px;
            line-height: 1.8;
            margin-bottom: 45px;
        }

        .buttons-container {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 32px;
            font-family: var(--font-main);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
            border: 2px solid var(--color-text);
        }

        .btn-primary { background-color: var(--color-text); color: white; }
        .btn-primary:hover { background-color: transparent; color: var(--color-text); }
        .btn-secondary { background-color: transparent; color: var(--color-text); }
        .btn-secondary:hover { background-color: var(--color-text); color: white; }
        .arrow { font-size: 1.1rem; line-height: 1; }

        /* INSTITUCIONAL */
        #institucional {
            background-color: var(--color-white);
            padding: 100px 20px;
            border-top: 1px solid #eaeaea;
        }

        .container { max-width: 1200px; margin: 0 auto; }

        .section-title {
            text-align: center;
            font-size: 1.8rem;
            font-weight: 700;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .section-subtitle {
            text-align: center;
            font-size: 0.85rem;
            color: var(--color-accent);
            text-transform: uppercase;
            letter-spacing: 0.2em;
            margin-bottom: 60px;
            font-weight: 600;
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .about-image {
            background-image: url('https://images.unsplash.com/photo-1529699211952-734e80c4d42b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');
            background-size: cover;
            background-position: center;
            height: 450px;
            position: relative;
        }

        .about-image::after {
            content: '';
            position: absolute;
            top: 20px; left: 20px;
            right: -20px; bottom: -20px;
            border: 2px solid var(--color-accent);
            z-index: -1;
        }

        .about-text h3 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 20px;
            letter-spacing: 0.05em;
        }

        .about-text p {
            font-size: 0.95rem;
            color: var(--color-text-light);
            margin-bottom: 20px;
            line-height: 1.8;
        }

        .highlight-box {
            background-color: var(--color-bg);
            border-left: 4px solid var(--color-accent);
            padding: 20px;
            margin-top: 30px;
        }

        .highlight-box p { margin-bottom: 0; font-weight: 600; color: var(--color-text); }

        /* DIRECTIVA */
        #directiva {
            background-color: var(--color-bg);
            padding: 100px 20px;
        }

        .board-list {
            max-width: 720px;
            margin: 0 auto;
            border-top: 1px solid var(--color-text);
        }

        .board-member {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 30px;
            padding: 28px 0;
            border-bottom: 1px solid #e5e5e5;
        }

        .board-name {
            font-size: 1.05rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            color: var(--color-text);
            line-height: 1.4;
        }

        .board-role {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--color-accent);
            text-align: right;
            flex-shrink: 0;
        }

        /* NOTICIAS */
        #noticias {
            background-color: var(--color-white);
            padding: 100px 20px;
            border-top: 1px solid #eaeaea;
        }

        .news-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .news-card {
            background-color: var(--color-bg);
            border: 1px solid #eaeaea;
            padding: 30px;
            transition: transform 0.3s ease;
        }

        .news-card:hover { transform: translateY(-5px); }

        .news-date {
            font-size: 0.75rem;
            color: var(--color-accent);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 10px;
            display: block;
        }

        .news-card h4 { font-size: 1.1rem; margin-bottom: 15px; line-height: 1.4; }
        .news-card p { font-size: 0.85rem; color: var(--color-text-light); margin-bottom: 20px; }

        .read-more {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-text);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .read-more:hover { color: var(--color-accent); }

        /* RESPONSIVIDAD */
        @media (max-width: 900px) {
            .about-grid { grid-template-columns: 1fr; }
            .about-image { height: 300px; order: -1; }
            .about-image::after { display: none; }
        }

        @media (max-width: 480px) {
            #hero h1 { font-size: 2.5rem; }
            #hero h2 { font-size: 0.75rem; }
            .buttons-container { flex-direction: column; width: 100%; }
            .btn { width: 100%; }
            .hero-logo-container { width: 140px; }
            .board-member { flex-direction: column; align-items: flex-start; gap: 6px; padding: 22px 0; }
            .board-role { text-align: left; }
        }
    </style>

    <!-- HERO -->
    <section id="hero">
        <div class="hero-logo-container">
            <img src="/assets/logo-adalp.png" alt="ADALP Logo">
        </div>
        <h1>ADALP</h1>
        <h2>Asociación Departamental<br>de Ajedrez de La Paz</h2>
        <div class="divider"></div>
        <p class="founding-date">Fundada el 7 de diciembre de 1929</p>
        <p class="institutional-text">
            Únicos representantes oficiales avalados por la Federación Boliviana de Ajedrez (FBA), con jurisdicción exclusiva en todo el Departamento de La Paz.
        </p>
        <div class="buttons-container">
            <a href="/jugadores/" class="btn btn-primary">Lista de Jugadores <span class="arrow">&rarr;</span></a>
            <a href="/galeria/" class="btn btn-secondary">Galería de Fotos <span class="arrow">&rarr;</span></a>
        </div>
    </section>

    <!-- INSTITUCIONAL -->
    <section id="institucional">
        <div class="container">
            <h2 class="section-title">Nuestra Institución</h2>
            <p class="section-subtitle">Casi un siglo de pasión por el ajedrez</p>

            <div class="about-grid">
                <div class="about-image"></div>
                <div class="about-text">
                    <h3>Pioneros del Ajedrez Paceño</h3>
                    <p>Desde nuestra fundación el <strong>7 de diciembre de 1929</strong>, la Asociación Departamental de Ajedrez de La Paz (ADALP) ha sido el pilar fundamental para el desarrollo y la difusión del deporte ciencia en nuestra región.</p>
                    <p>A lo largo de casi 100 años, hemos organizado innumerables torneos, formado a generaciones de maestros y fomentado los valores de disciplina, estrategia y comunidad entre todos nuestros afiliados.</p>

                    <div class="highlight-box">
                        <p>Somos los únicos representantes oficiales avalados por la Federación Boliviana de Ajedrez (FBA), con jurisdicción exclusiva en todo el Departamento de La Paz.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- DIRECTIVA -->
    <section id="directiva">
        <div class="container">
            <h2 class="section-title">Directiva</h2>
            <p class="section-subtitle">Autoridades en ejercicio</p>

            <div class="board-list">
                {directiva.map((member) => (
                    <div class="board-member">
                        <span class="board-name">{member.nombre}</span>
                        <span class="board-role">{member.cargo}</span>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- NOTICIAS -->
    <section id="noticias">
        <div class="container">
            <h2 class="section-title">Actualidad</h2>
            <p class="section-subtitle">Próximos torneos y noticias</p>

            <div class="news-grid">
                <article class="news-card">
                    <span class="news-date">15 de Octubre, 2026</span>
                    <h4>Torneo Departamental de Ajedrez Clásico</h4>
                    <p>Inscripciones abiertas para el torneo oficial válido por el ranking departamental. ¡Cupos limitados!</p>
                    <a href="#" class="read-more">Leer más &rarr;</a>
                </article>
                <article class="news-card">
                    <span class="news-date">02 de Octubre, 2026</span>
                    <h4>Clínicas de Ajedrez para Jóvenes Promesas</h4>
                    <p>La ADALP invita a todos los menores de 18 años a participar de las clases magistrales gratuitas en nuestra sede.</p>
                    <a href="#" class="read-more">Leer más &rarr;</a>
                </article>
                <article class="news-card">
                    <span class="news-date">20 de Septiembre, 2026</span>
                    <h4>Resultados del Campeonato Nacional</h4>
                    <p>Nuestros representantes paceños tuvieron una destacada participación en el último certamen nacional.</p>
                    <a href="#" class="read-more">Leer más &rarr;</a>
                </article>
            </div>
        </div>
    </section>
</Layout>
