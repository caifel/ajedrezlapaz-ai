---
import Layout from '../layouts/Layout.astro';
import TorneoCard from '../components/TorneoCard.astro';
import TorneoStatusRefresh from '../components/TorneoStatusRefresh.astro';
import directiva from '../data/directiva.json';
import { getTorneos, getEventSchema } from '../lib/torneos';

const tournaments = getTorneos();

const torneosDestacados = tournaments
  .filter((torneo) => !torneo.esPasado)
  .sort((a, b) => a.fecha.localeCompare(b.fecha))
  .slice(0, 3);

const siteUrl = Astro.site ?? new URL('https://ajedrezlapaz.com');
const eventSchemas = torneosDestacados.map((torneo) => getEventSchema(torneo, siteUrl));
---

<Layout
  title="Asociación Departamental de Ajedrez de La Paz (ADALP)"
  description="Sitio oficial de la Asociación Departamental de Ajedrez de La Paz (ADALP), fundada en 1929. Consulta jugadores, categorías y certificados oficiales."
  schema={eventSchemas}
>
  <style is:global>
    header .header-logo img {
      height: 35px;
    }

    /* HERO */
    #hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 120px 20px 80px;
      text-align: center;
    }

    .hero-logo-container {
      width: 180px;
      margin-bottom: 38px;
    }
    .hero-logo-container img {
      width: 100%;
      height: auto;
      display: block;
    }

    #hero h1 {
      font-size: 3.5rem;
      font-weight: 700;
      letter-spacing: 0.35em;
      margin-left: 0.35em;
      margin-bottom: 14px;
      color: #1a1a1a;
    }

    #hero h2 {
      font-size: 0.85rem;
      font-weight: 400;
      letter-spacing: 0.25em;
      margin-left: 0.25em;
      margin-bottom: 30px;
      color: #333333;
      text-transform: uppercase;
      max-width: 600px;
    }

    .divider {
      width: 60px;
      height: 2px;
      background-color: var(--color-accent);
      margin: 0 auto 30px auto;
    }

    .founding-date {
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 1.5px;
      margin-left: 1.5px;
      color: #6b6b6b;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .institutional-text {
      font-size: 0.9rem;
      font-weight: 300;
      color: #4a4a4a;
      max-width: 600px;
      line-height: 1.8;
      margin-bottom: 48px;
    }

    .buttons-container {
      display: flex;
      gap: 20px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 16px 32px;
      font-family: var(--font-main);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.3s ease;
      cursor: pointer;
      border: 2px solid #1f1f1f;
    }

    .btn-primary {
      background-color: #1f1f1f;
      color: white;
    }
    .btn-primary:hover {
      background-color: transparent;
      border-color: var(--color-accent);
      color: #1a1a1a;
    }
    .btn-secondary {
      background-color: transparent;
      color: #1f1f1f;
    }
    .btn-secondary:hover {
      background-color: var(--color-accent);
      border-color: var(--color-accent);
      color: #1a1a1a;
    }
    .arrow {
      color: var(--color-accent-text);
      font-size: 1.1rem;
      line-height: 1;
    }
    .btn-primary .arrow {
      color: var(--color-accent);
    }
    .btn-primary:hover .arrow {
      color: var(--color-accent-text);
    }
    .btn-secondary:hover .arrow {
      color: #1a1a1a;
    }
    .hero-contact {
      margin-top: 26px;
      color: #6b6b6b;
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-align: center;
    }
    .hero-contact a {
      color: var(--color-accent-text);
      font-weight: 600;
      text-decoration: none;
      border-bottom: 1px solid currentColor;
      padding-bottom: 2px;
    }
    .hero-contact a:hover {
      color: #1a1a1a;
    }

    /* INSTITUCIONAL */
    #institucional {
      background-color: var(--color-white);
      padding: 100px 20px;
      border-top: 1px solid #eaeaea;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .section-title {
      text-align: center;
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 15px;
    }

    .section-subtitle {
      text-align: center;
      font-size: 0.85rem;
      color: var(--color-accent-text);
      text-transform: uppercase;
      letter-spacing: 0.2em;
      margin-bottom: 60px;
      font-weight: 600;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-image {
      background-image: url('https://images.unsplash.com/photo-1529699211952-734e80c4d42b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');
      background-size: cover;
      background-position: center;
      height: 450px;
      position: relative;
    }

    .about-image::after {
      content: '';
      position: absolute;
      top: 20px;
      left: 20px;
      right: -20px;
      bottom: -20px;
      border: 2px solid var(--color-accent);
      z-index: -1;
    }

    .about-text h3 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 20px;
      letter-spacing: 0.05em;
    }

    .about-text p {
      font-size: 0.95rem;
      color: var(--color-text-light);
      margin-bottom: 20px;
      line-height: 1.8;
    }

    .highlight-box {
      background-color: var(--color-bg);
      border-left: 4px solid var(--color-accent);
      padding: 20px;
      margin-top: 30px;
    }

    .highlight-box p {
      margin-bottom: 0;
      font-weight: 600;
      color: var(--color-text);
    }

    /* DIRECTIVA */
    #directiva {
      background-color: var(--color-bg);
      padding: 100px 20px;
    }

    .board-list {
      max-width: 720px;
      margin: 0 auto;
      border-top: 1px solid var(--color-text);
    }

    .board-member {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 30px;
      padding: 28px 0;
      border-bottom: 1px solid #e5e5e5;
    }

    .board-name {
      font-size: 1.05rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--color-text);
      line-height: 1.4;
    }

    .board-role {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--color-accent-text);
      text-align: right;
      flex-shrink: 0;
    }

    /* TORNEOS */
    #torneos {
      background-color: var(--color-white);
      padding: 100px 20px;
      border-top: 1px solid #eaeaea;
    }

    .news-more {
      margin-top: 32px;
      text-align: center;
    }

    .news-more-link {
      color: var(--color-text);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
    }

    .news-more-link:hover {
      color: var(--color-accent-text);
    }

    /* RESPONSIVIDAD */
    @media (max-width: 900px) {
      .about-grid {
        grid-template-columns: 1fr;
      }
      .about-image {
        height: 300px;
        order: -1;
      }
      .about-image::after {
        display: none;
      }
    }

    @media (max-width: 480px) {
      #hero h1 {
        font-size: 2.5rem;
      }
      #hero h2 {
        font-size: 0.75rem;
      }
      .buttons-container {
        flex-direction: column;
        width: 100%;
      }
      .btn {
        width: 100%;
      }
      .hero-logo-container {
        width: 140px;
      }
      .board-member {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        padding: 22px 0;
      }
      .board-role {
        text-align: left;
      }
    }
  </style>

  <main>
    <!-- HERO -->
    <section id="hero">
      <div class="hero-logo-container">
        <img src="/assets/logo-adalp.svg" alt="ADALP Logo" width="114" height="114" />
      </div>
      <h1>ADALP</h1>
      <h2>Asociación Departamental<br />de Ajedrez de La Paz</h2>
      <div class="divider"></div>
      <p class="founding-date">Fundada el 7 de diciembre de 1929</p>
      <p class="institutional-text">Únicos representantes oficiales del ajedrez en el departamento de La Paz.</p>
      <div class="buttons-container">
        <a href="/torneos/" class="btn btn-primary">Ver torneos <span class="arrow">&rarr;</span></a>
        <a href="/jugadores/" class="btn btn-secondary">Lista de Jugadores <span class="arrow">&rarr;</span></a>
      </div>
      <p class="hero-contact">
        ¿Consultas?
        <a href="https://wa.me/59173505230" target="_blank" rel="noopener">Escríbenos por WhatsApp &rarr;</a>
      </p>
    </section>

    <!-- INSTITUCIONAL -->
    <section id="institucional">
      <div class="container">
        <h2 class="section-title">Nuestra Institución</h2>
        <p class="section-subtitle">Casi un siglo de pasión por el ajedrez</p>

        <div class="about-grid">
          <div class="about-image"></div>
          <div class="about-text">
            <h3>Pioneros del Ajedrez Paceño</h3>
            <p>
              Desde nuestra fundación el <strong>7 de diciembre de 1929</strong>, la Asociación Departamental de Ajedrez
              de La Paz (ADALP) ha sido el pilar fundamental para el desarrollo y la difusión del deporte ciencia en
              nuestra región.
            </p>
            <p>
              A lo largo de casi 100 años, hemos organizado innumerables torneos, formado a generaciones de maestros y
              fomentado los valores de disciplina, estrategia y comunidad entre todos nuestros afiliados.
            </p>

            <div class="highlight-box">
              <p>
                Somos los únicos representantes oficiales avalados por la Federación Boliviana de Ajedrez (FBA), con
                jurisdicción exclusiva en todo el Departamento de La Paz.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DIRECTIVA -->
    <section id="directiva">
      <div class="container">
        <h2 class="section-title">Directiva</h2>
        <p class="section-subtitle">Autoridades en ejercicio</p>

        <div class="board-list">
          {
            directiva.map((member) => (
              <div class="board-member">
                <span class="board-name">{member.nombre}</span>
                <span class="board-role">{member.cargo}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TORNEOS -->
    <section id="torneos">
      <div class="container">
        <h2 class="section-title">Torneos</h2>
        <p class="section-subtitle">Calendario de competencias</p>

        <div class="news-group">
          <h3 class="news-group-title">Próximos</h3>
          {
            torneosDestacados.length > 0 ? (
              <div class="news-grid">
                {torneosDestacados.map((torneo) => (
                  <TorneoCard torneo={torneo} />
                ))}
              </div>
            ) : (
              <p class="news-empty">No hay torneos programados por el momento.</p>
            )
          }
          <div class="news-more">
            <a class="news-more-link" href="/torneos/">Ver calendario completo &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <TorneoStatusRefresh />
</Layout>
