---
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getConvocatoriaUrl } from '../../lib/convocatorias.js';
import { getQrUrl } from '../../lib/qr.js';
import { getDescripcionTorneo, quitarEmojis } from '../../lib/seo.js';
import { getTorneos, getEventSchema, getWhatsappUrl } from '../../lib/torneos';
import { formatDiasHasta } from '../../lib/torneoStatus.js';

export function getStaticPaths() {
  return getTorneos().map((torneo) => ({
    params: { id: torneo.id },
    props: { torneo }
  }));
}

const { torneo } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://ajedrezlapaz.com');
const pageDescription = getDescripcionTorneo(torneo);
const pageSchema = getEventSchema(torneo, siteUrl);
const verifierUrl = import.meta.env.PUBLIC_VERIFIER_URL || 'https://verifier.ajedrezlapaz.com/verify';

const convocatoriaUrl = getConvocatoriaUrl(torneo, verifierUrl);
const qrUrl = getQrUrl(torneo, verifierUrl);
const qrViewUrl = qrUrl ? `${qrUrl}${qrUrl.includes('?') ? '&' : '?'}inline=1` : '';
const tieneQr = Boolean(qrUrl);
const torneoAbierto = torneo.estado === 'abierto';

const formularioUrl =
  typeof torneo.formulario === 'string' && /^https?:\/\//i.test(torneo.formulario.trim())
    ? torneo.formulario.trim()
    : '';

const etiquetaPagoQr = torneo.precioTexto ? `Pagar ${torneo.precioTexto} por QR` : 'Pagar por QR';
const mensajeInscripcion =
  tieneQr && !formularioUrl
    ? `Hola, ya realicé el pago${torneo.precioTexto ? ` de ${torneo.precioTexto}` : ''} para: ${torneo.titulo}. Envío mi comprobante.`
    : `Hola, quiero inscribirme en: ${torneo.titulo}.`;

const inscripcionUrl = getWhatsappUrl(torneo.whatsapp, mensajeInscripcion);
const consultaUrl = getWhatsappUrl(torneo.whatsapp, `Hola, quisiera consultar sobre: ${torneo.titulo}.`);

const primaryAction =
  torneoAbierto && inscripcionUrl
    ? {
        href: tieneQr ? qrViewUrl : inscripcionUrl,
        cta: tieneQr ? 'pagar-qr' : 'inscribirme',
        ariaLabel: tieneQr
          ? `${etiquetaPagoQr}: ${torneo.titulo}`
          : `Inscribirme en ${torneo.titulo} por WhatsApp`
      }
    : null;

let secondaryLink = null;
if (torneoAbierto) {
  if (formularioUrl) {
    secondaryLink = {
      href: formularioUrl,
      label: 'Llenar formulario de registro',
      cta: 'formulario',
      ariaLabel: `Llenar formulario de registro de ${torneo.titulo}`
    };
  } else if (tieneQr && inscripcionUrl) {
    secondaryLink = {
      href: inscripcionUrl,
      label: 'Enviar comprobante por WhatsApp',
      cta: 'enviar-comprobante',
      ariaLabel: `Enviar comprobante de pago por WhatsApp para ${torneo.titulo}`
    };
  }
}

const buttonActions = [];
if (torneo.enlace) {
  buttonActions.push({
    href: torneo.enlace,
    label: torneo.estado === 'finalizado' ? 'Ver resultados' : 'Ver evento',
    cta: 'evento'
  });
}
if (!torneoAbierto && !torneo.enlace && consultaUrl) {
  buttonActions.push({
    href: consultaUrl,
    label: 'Consultar por WhatsApp',
    cta: 'consulta'
  });
}
---

<Layout
  title={`${torneo.titulo} | ADALP La Paz`}
  description={pageDescription}
  image={`/og/${torneo.id}.png`}
  imageAlt={`${quitarEmojis(torneo.titulo)} — ${torneo.fecha_texto}`}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Torneos', path: '/torneos/' },
    { name: torneo.titulo, path: `/torneos/${torneo.id}/` }
  ]}
  schema={[pageSchema]}
>
  <style>
    :global(body) {
      --color-bg: #ffffff;
      --color-text: #000000;
      --color-text-light: #666666;
      --color-border: #eeeeee;
      --color-action-hover: #2a2a2a;
      --color-price: #00d108;
    }

    main {
      flex: 1;
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: 150px 24px 90px;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 36px;
      color: var(--color-text-light);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-decoration: none;
    }

    .back-link:hover {
      color: var(--color-text);
    }

    .tournament-header {
      margin-bottom: 56px;
    }

    .tournament-title {
      margin-bottom: 16px;
      font-size: clamp(1.6rem, 3.6vw, 2.2rem);
      font-weight: 300;
      letter-spacing: 0.12em;
      line-height: 1.25;
      text-transform: uppercase;
      text-wrap: balance;
    }

    .tournament-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 14px;
    }

    .tournament-date {
      margin: 0 0 16px;
      color: var(--color-text);
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .section-label {
      margin-bottom: 20px;
      color: var(--color-text-light);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .organizers {
      margin-top: 64px;
      padding-top: 36px;
      border-top: 1px solid var(--color-border);
    }

    .organizer-list {
      display: flex;
      flex-wrap: wrap;
      gap: 18px 40px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .organizer {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: inherit;
      text-decoration: none;
    }

    .organizer:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 4px;
    }

    .organizer-logo {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
    }

    .organizer-logo img {
      width: 40px;
      height: 40px;
      object-fit: contain;
      filter: grayscale(1);
      opacity: 0.55;
      transition:
        filter 0.25s ease,
        opacity 0.25s ease;
    }

    .organizer:hover .organizer-logo img,
    .organizer:focus-visible .organizer-logo img {
      filter: none;
      opacity: 1;
    }

    .organizer-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
    }

    .organizer-name {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.65;
      transition: opacity 0.25s ease;
    }

    .organizer:hover .organizer-name,
    .organizer:focus-visible .organizer-name {
      opacity: 1;
    }

    .organizer-full {
      color: var(--color-text-light);
      font-size: 0.62rem;
      line-height: 1.35;
    }

    .detail-list {
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--color-border);
      list-style: none;
    }

    .detail-list li {
      padding: 18px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .detail-convocatoria a {
      color: var(--color-text-light);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color 0.2s ease;
    }

    .detail-convocatoria a:hover,
    .detail-convocatoria a:focus-visible {
      color: var(--color-text);
    }

    .tournament-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      margin-top: 48px;
    }

    .action-note,
    .action-link {
      font-family: var(--font-main);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .action-note {
      color: var(--color-text-light);
      font-weight: 600;
    }

    .action-link {
      color: var(--color-text);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color 0.2s ease;
    }

    .action-link:hover,
    .action-link:focus-visible {
      color: var(--color-accent-text);
    }

    .action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-height: 50px;
      padding: 14px 26px;
      border: 2px solid var(--color-text);
      border-radius: 2px;
      font-family: var(--font-main);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      line-height: 1;
      text-align: center;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
    }

    .action:focus-visible {
      outline: 2px solid var(--color-accent-text);
      outline-offset: 3px;
    }

    .action-primary {
      background-color: var(--color-text);
      border-color: var(--color-text);
      color: var(--color-white);
    }

    .action-primary:hover {
      background-color: var(--color-action-hover);
      border-color: var(--color-action-hover);
      color: var(--color-white);
      transform: translateY(-1px);
    }

    .action-primary:active {
      transform: translateY(0);
    }

    .action-secondary {
      background-color: transparent;
      color: var(--color-text);
    }

    .action-secondary:hover {
      background-color: var(--color-text);
      color: var(--color-white);
      transform: translateY(-1px);
    }

    .action-price {
      color: var(--color-price);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .action-icon {
      flex: 0 0 auto;
      width: 18px;
      height: 18px;
    }

    .action-arrow {
      font-size: 1.05rem;
      line-height: 1;
    }

    .tournament-actions[hidden] {
      display: none;
    }

    @media (max-width: 600px) {
      main {
        padding: 120px 24px 70px;
      }

      .back-link {
        margin-bottom: 28px;
      }

      .tournament-header {
        margin-bottom: 44px;
      }

      .tournament-title {
        font-size: 1.35rem;
        letter-spacing: 0.1em;
      }

      .organizer-list {
        flex-direction: column;
        gap: 14px;
      }

      .organizers {
        margin-top: 48px;
        padding-top: 30px;
      }

      .tournament-actions {
        align-items: stretch;
      }

      .action-note {
        align-self: flex-start;
      }

      .action-link {
        align-self: center;
        text-align: center;
      }

      .action {
        width: 100%;
      }
    }
  </style>

  <main data-torneo-detalle data-inicio={torneo.inicio} data-fin={torneo.fin} data-estado={torneo.estado}>
    <a class="back-link" href="/torneos/">&larr; Torneos</a>

    <div class="tournament-header">
      <h1 class="tournament-title">{torneo.titulo}</h1>
      <p class="tournament-date">{torneo.fecha_texto}</p>
      <div class="tournament-meta">
        <StatusBadge
          tone="days"
          size="md"
          label={formatDiasHasta(torneo.diasHasta)}
          data-days
          hidden={!(torneo.diasHasta > 0)}
        />
        <StatusBadge tone="hoy" size="md" label="HOY" data-today hidden={!torneo.esHoy} />
        {torneo.esOnline && <StatusBadge tone="online" size="md" label="Online" />}
        <StatusBadge tone={torneo.estado} size="md" label={torneo.estadoLabel} data-status-badge />
      </div>
    </div>

    <section aria-labelledby="detalles-title">
      <h2 class="section-label" id="detalles-title">Detalles</h2>
      <ul class="detail-list">
        <li>
          {torneo.horario.map((parte) => (parte.fuerte ? <strong>{parte.texto}</strong> : parte.texto))}
        </li>
        {(torneo.detalles ?? []).map((detalle) => <li>{detalle}</li>)}
        {
          convocatoriaUrl && (
            <li class="detail-convocatoria">
              <a
                href={convocatoriaUrl}
                target="_blank"
                rel="noopener"
                type="application/pdf"
                aria-label={`Ver convocatoria en PDF de ${torneo.titulo}`}
              >
                Ver convocatoria oficial (PDF) <span aria-hidden="true">&nearr;</span>
              </a>
            </li>
          )
        }
      </ul>
    </section>

    <div class="tournament-actions">
      {torneo.precioTexto && !tieneQr && <span class="action-note">{torneo.precioTexto}</span>}
      {primaryAction && (
        <a
          class="action action-primary"
          href={primaryAction.href}
          target="_blank"
          rel="noopener"
          data-cta={primaryAction.cta}
          aria-label={primaryAction.ariaLabel}
        >
          {tieneQr && (
            <svg class="action-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M3 3h7v7H3V3Zm2 2v3h3V5H5Zm9-2h7v7h-7V3Zm2 2v3h3V5h-3ZM3 14h7v7H3v-7Zm2 2v3h3v-3H5Zm9-2h2v2h-2v-2Zm2 2h2v2h-2v-2Zm2-2h2v2h-2v-2Zm0 4h2v2h-2v-2Zm-2 2h2v2h-2v-2Zm-2-2h2v2h-2v-2Zm-2 2h2v2h-2v-2Z"
              />
            </svg>
          )}
          <span>
            {tieneQr && torneo.precioTexto ? (
              <>Pagar <strong class="action-price">{torneo.precioTexto}</strong> por QR</>
            ) : (
              tieneQr ? 'Pagar por QR' : 'Inscribirme por WhatsApp'
            )}
          </span>
          <span class="action-arrow" aria-hidden="true">&rarr;</span>
        </a>
      )}
      {secondaryLink && (
        <a
          class="action-link"
          href={secondaryLink.href}
          target="_blank"
          rel="noopener"
          data-cta={secondaryLink.cta}
          aria-label={secondaryLink.ariaLabel}
        >
          {secondaryLink.label}
        </a>
      )}
      {buttonActions.map((action) => (
        <a
          class="action action-secondary"
          href={action.href}
          target="_blank"
          rel="noopener"
          data-cta={action.cta}
        >
          {action.label} <span aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>

    <section class="organizers" aria-labelledby="organizadores-title">
      <h2 class="section-label" id="organizadores-title">
        {torneo.organizadores.length === 1 ? 'Organiza' : 'Organizan'}
      </h2>
      <ul class="organizer-list">
        {
          torneo.organizadores.map((organizacion) => {
            const nombreCorto = organizacion.corto ?? organizacion.nombre;

            return (
              <li>
                <a
                  class="organizer"
                  href={organizacion.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Ver ${organizacion.nombre}`}
                >
                  <span class="organizer-logo">
                    <img
                      src={organizacion.logo}
                      alt=""
                      width={organizacion.width}
                      height={organizacion.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="organizer-info">
                    <span class="organizer-name">{nombreCorto}</span>
                    {nombreCorto !== organizacion.nombre && <span class="organizer-full">{organizacion.nombre}</span>}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>
  </main>

  <script>
    import { refreshTorneo } from '../../lib/torneoRefresh.js';

    document.addEventListener('DOMContentLoaded', () => {
      const root = document.querySelector('[data-torneo-detalle]');
      if (!root) return;

      refreshTorneo(root);

      // Si el torneo terminó después del build y no queda otra acción, ocultamos la zona.
      const actions = root.querySelector('.tournament-actions');
      if (actions && !actions.querySelector('a:not([hidden])')) actions.hidden = true;
    });
  </script>
</Layout>
