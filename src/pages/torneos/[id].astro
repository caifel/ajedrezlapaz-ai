---
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getDescripcionTorneo, quitarEmojis } from '../../lib/seo.js';
import { getTorneos, getEventSchema, getWhatsappUrl } from '../../lib/torneos';
import { formatDiasHasta } from '../../lib/torneoStatus.js';

export function getStaticPaths() {
  return getTorneos().map((torneo) => ({
    params: { id: torneo.id },
    props: { torneo }
  }));
}

const { torneo } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://ajedrezlapaz.com');
const pageDescription = getDescripcionTorneo(torneo);
const pageSchema = getEventSchema(torneo, siteUrl);

const inscripcionUrl = getWhatsappUrl(
  torneo.whatsapp,
  `Hola, quiero inscribirme en: ${torneo.titulo}.`
);
const consultaUrl = getWhatsappUrl(
  torneo.whatsapp,
  `Hola, quisiera consultar sobre: ${torneo.titulo}.`
);
---

<Layout
  title={`${torneo.titulo} | ADALP La Paz`}
  description={pageDescription}
  image={`/og/${torneo.id}.png`}
  imageAlt={`${quitarEmojis(torneo.titulo)} — ${torneo.fecha_texto}`}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Torneos', path: '/torneos/' },
    { name: torneo.titulo, path: `/torneos/${torneo.id}/` }
  ]}
  schema={[pageSchema]}
>
  <style>
    :global(body) {
      --color-bg: #ffffff;
      --color-text: #000000;
      --color-text-light: #666666;
      --color-border: #eeeeee;
    }

    main {
      flex: 1;
      width: 100%;
      max-width: 720px;
      margin: 0 auto;
      padding: 150px 24px 90px;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 36px;
      color: var(--color-text-light);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-decoration: none;
    }

    .back-link:hover {
      color: var(--color-text);
    }

    .tournament-header {
      margin-bottom: 56px;
    }

    .tournament-title {
      margin-bottom: 16px;
      font-size: clamp(1.6rem, 3.6vw, 2.2rem);
      font-weight: 300;
      letter-spacing: 0.12em;
      line-height: 1.25;
      text-transform: uppercase;
      text-wrap: balance;
    }

    .tournament-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 14px;
    }

    .tournament-date {
      margin: 0 0 16px;
      color: var(--color-text);
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }


    .section-label {
      margin-bottom: 20px;
      color: var(--color-text-light);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .organizers {
      margin-top: 64px;
      padding-top: 36px;
      border-top: 1px solid var(--color-border);
    }

    .organizer-list {
      display: flex;
      flex-wrap: wrap;
      gap: 18px 40px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .organizer {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: inherit;
      text-decoration: none;
    }

    .organizer:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 4px;
    }

    .organizer-logo {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
    }

    .organizer-logo img {
      width: 40px;
      height: 40px;
      object-fit: contain;
      filter: grayscale(1);
      opacity: 0.55;
      transition:
        filter 0.25s ease,
        opacity 0.25s ease;
    }

    .organizer:hover .organizer-logo img,
    .organizer:focus-visible .organizer-logo img {
      filter: none;
      opacity: 1;
    }

    .organizer-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
    }

    .organizer-name {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.65;
      transition: opacity 0.25s ease;
    }

    .organizer:hover .organizer-name,
    .organizer:focus-visible .organizer-name {
      opacity: 1;
    }

    .organizer-full {
      color: var(--color-text-light);
      font-size: 0.62rem;
      line-height: 1.35;
    }

    .detail-list {
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--color-border);
      list-style: none;
    }

    .detail-list li {
      padding: 18px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .tournament-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 48px;
    }

    .action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 22px;
      border: 2px solid var(--color-text);
      font-family: var(--font-main);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-decoration: none;
      transition:
        background-color 0.25s ease,
        color 0.25s ease;
    }

    .action-primary {
      background-color: var(--color-text);
      color: #ffffff;
    }

    .action-primary:hover {
      background-color: transparent;
      color: var(--color-text);
    }

    .action-secondary {
      background-color: transparent;
      color: var(--color-text);
    }

    .action-secondary:hover {
      background-color: var(--color-text);
      color: #ffffff;
    }

    .action[hidden],
    .tournament-actions[hidden] {
      display: none;
    }

    @media (max-width: 600px) {
      main {
        padding: 120px 24px 70px;
      }

      .back-link {
        margin-bottom: 28px;
      }

      .tournament-header {
        margin-bottom: 44px;
      }

      .tournament-title {
        font-size: 1.35rem;
        letter-spacing: 0.1em;
      }

      .organizer-list {
        flex-direction: column;
        gap: 14px;
      }

      .organizers {
        margin-top: 48px;
        padding-top: 30px;
      }

      .tournament-actions {
        flex-direction: column;
      }

      .action {
        width: 100%;
      }
    }
  </style>

  <main
    data-torneo-detalle
    data-inicio={torneo.inicio}
    data-fin={torneo.fin}
    data-estado={torneo.estado}
  >
    <a class="back-link" href="/torneos/">&larr; Torneos</a>

    <div class="tournament-header">
      <h1 class="tournament-title">{torneo.titulo}</h1>
      <p class="tournament-date">{torneo.fecha_texto}</p>
      <div class="tournament-meta">
        <StatusBadge
          tone="days"
          size="md"
          label={formatDiasHasta(torneo.diasHasta)}
          data-days
          hidden={!(torneo.diasHasta > 0)}
        />
        <StatusBadge tone="hoy" size="md" label="HOY" data-today hidden={!torneo.esHoy} />
        {torneo.esOnline && <StatusBadge tone="online" size="md" label="Online" />}
        <StatusBadge
          tone={torneo.estado}
          size="md"
          label={torneo.estadoLabel}
          data-status-badge
        />
      </div>
    </div>

    <section aria-labelledby="detalles-title">
      <h2 class="section-label" id="detalles-title">Detalles</h2>
      <ul class="detail-list">
        <li>
          {torneo.horario.map((parte) =>
            parte.fuerte ? <strong>{parte.texto}</strong> : parte.texto
          )}
        </li>
        {(torneo.detalles ?? []).map((detalle) => <li>{detalle}</li>)}
      </ul>
    </section>

    <div class="tournament-actions">
      {torneo.estado === 'abierto' && inscripcionUrl && (
        <a
          class="action action-primary"
          href={inscripcionUrl}
          target="_blank"
          rel="noopener"
          data-cta="inscribirme"
        >
          Inscribirme por WhatsApp <span aria-hidden="true">&rarr;</span>
        </a>
      )}
      {torneo.enlace && (
        <a class="action action-secondary" href={torneo.enlace} target="_blank" rel="noopener">
          {torneo.estado === 'finalizado' ? 'Ver resultados' : 'Ver evento'}
          <span aria-hidden="true">&rarr;</span>
        </a>
      )}
      {torneo.estado !== 'abierto' && !torneo.enlace && consultaUrl && (
        <a class="action action-secondary" href={consultaUrl} target="_blank" rel="noopener">
          Consultar por WhatsApp <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </div>

    <section class="organizers" aria-labelledby="organizadores-title">
      <h2 class="section-label" id="organizadores-title">
        {torneo.organizadores.length === 1 ? 'Organiza' : 'Organizan'}
      </h2>
      <ul class="organizer-list">
        {torneo.organizadores.map((organizacion) => {
          const nombreCorto = organizacion.corto ?? organizacion.nombre;

          return (
            <li>
              <a
                class="organizer"
                href={organizacion.url}
                target="_blank"
                rel="noopener"
                aria-label={`Ver ${organizacion.nombre}`}
              >
                <span class="organizer-logo">
                  <img
                    src={organizacion.logo}
                    alt=""
                    width={organizacion.width}
                    height={organizacion.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="organizer-info">
                  <span class="organizer-name">{nombreCorto}</span>
                  {nombreCorto !== organizacion.nombre && (
                    <span class="organizer-full">{organizacion.nombre}</span>
                  )}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </main>

  <script>
    import { refreshTorneo } from '../../lib/torneoRefresh.js';

    document.addEventListener('DOMContentLoaded', () => {
      const root = document.querySelector('[data-torneo-detalle]');
      if (!root) return;

      refreshTorneo(root);

      // Si el torneo terminó después del build y no queda otra acción, ocultamos la zona.
      const actions = root.querySelector('.tournament-actions');
      if (actions && !actions.querySelector('a:not([hidden])')) actions.hidden = true;
    });
  </script>
</Layout>
