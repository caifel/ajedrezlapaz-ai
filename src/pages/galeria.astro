---
import Layout from '../layouts/Layout.astro';
import photos from '../data/galeria.json';

const albums = [...new Set(photos.map((photo) => photo.album))];
const miniatura = (url) => url.replace('w=1200&q=80', 'w=600&h=600&fit=crop&q=70');

const siteUrl = Astro.site ?? new URL('https://ajedrezlapaz.com');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const pageDescription = 'Galería de fotos de torneos, campeonatos y actividades de la Asociación Departamental de Ajedrez de La Paz (ADALP).';

const pageSchema = {
    '@context': 'https://schema.org',
    '@type': 'ImageGallery',
    name: 'Galería de Fotos | ADALP',
    description: pageDescription,
    url: pageUrl,
    inLanguage: 'es-BO',
    isPartOf: { '@id': new URL('/#website', siteUrl).href },
    about: { '@id': new URL('/#organization', siteUrl).href },
};
---

<Layout
    title="Galería de Fotos | ADALP La Paz"
    description={pageDescription}
    breadcrumbs={[
        { name: 'Inicio', path: '/' },
        { name: 'Galería', path: '/galeria/' },
    ]}
    schema={[pageSchema]}
>
    <style is:global>
        body {
            --color-bg: #ffffff;
            --color-text: #000000;
            --color-text-light: #888888;
            --color-border: #eeeeee;
        }

        /* CONTENIDO */
        main {
            flex: 1;
            padding: 160px 20px 100px;
            max-width: 1100px;
            margin: 0 auto;
            width: 100%;
        }

        .page-title {
            text-align: center;
            font-size: 1.8rem;
            font-weight: 300;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .page-subtitle {
            text-align: center;
            font-size: 0.7rem;
            color: var(--color-text-light);
            text-transform: uppercase;
            letter-spacing: 0.2em;
            margin-bottom: 60px;
        }

        /* Filtros (Tags de álbum) */
        .tags-container {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 60px;
            padding-bottom: 25px;
            border-bottom: 1px solid var(--color-border);
        }

        .tag {
            font-size: 0.75rem;
            font-weight: 400;
            color: var(--color-text-light);
            text-transform: uppercase;
            cursor: pointer;
            letter-spacing: 0.1em;
            transition: all 0.3s ease;
            position: relative;
            padding-bottom: 2px;
        }

        .tag:hover { color: var(--color-text); }
        .tag.active { color: var(--color-text); font-weight: 700; }
        .tag.active::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0;
            width: 100%; height: 1px;
            background-color: var(--color-text);
        }

        /* Grid de fotos */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 4px;
        }

        .gallery-item {
            position: relative;
            overflow: hidden;
            cursor: pointer;
            aspect-ratio: 1 / 1;
            background-color: var(--color-border);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            filter: grayscale(100%);
            transition: filter 0.5s ease, transform 0.5s ease;
        }

        .gallery-item:hover img {
            filter: grayscale(0%);
            transform: scale(1.03);
        }

        /* Info que aparece sobre la foto al hacer hover */
        .gallery-item-info {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 20px;
            background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0) 100%);
            color: white;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .gallery-item:hover .gallery-item-info { opacity: 1; }

        .gallery-item-info h4 {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            margin-bottom: 5px;
        }

        .gallery-item-info p {
            font-size: 0.7rem;
            font-weight: 300;
            opacity: 0.8;
            letter-spacing: 0.05em;
        }

        /* Estados */
        .loading, .no-results {
            text-align: center;
            padding: 60px 20px;
            color: var(--color-text-light);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            grid-column: 1 / -1;
        }

        /* =========================================
           LIGHTBOX
           ========================================= */
        .lightbox {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100vh;
            background-color: rgba(0, 0, 0, 0.96);
            z-index: 3000;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.4s ease, visibility 0.4s ease;
        }

        .lightbox.active {
            opacity: 1;
            visibility: visible;
        }

        .lightbox-content {
            max-width: 1200px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .lightbox-image {
            max-width: 100%;
            max-height: 75vh;
            object-fit: contain;
            display: block;
        }

        .lightbox-info {
            margin-top: 25px;
            text-align: center;
            color: white;
            max-width: 700px;
        }

        .lightbox-album {
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.25em;
            color: var(--color-accent);
            margin-bottom: 8px;
        }

        .lightbox-description {
            font-size: 0.85rem;
            font-weight: 300;
            color: #cccccc;
            line-height: 1.7;
        }

        .lightbox-close {
            position: fixed;
            top: 25px;
            right: 30px;
            background: none;
            border: none;
            font-size: 2rem;
            font-weight: 300;
            color: white;
            cursor: pointer;
            line-height: 1;
            z-index: 3100;
            transition: opacity 0.3s ease;
        }

        .lightbox-close:hover { opacity: 0.5; }

        .lightbox-nav {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            font-size: 2.5rem;
            font-weight: 200;
            color: white;
            cursor: pointer;
            padding: 20px;
            z-index: 3100;
            transition: opacity 0.3s ease;
            line-height: 1;
        }

        .lightbox-nav:hover { opacity: 0.5; }
        .lightbox-prev { left: 20px; }
        .lightbox-next { right: 20px; }

        /* RESPONSIVIDAD */
        @media (max-width: 900px) {
            .gallery-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .lightbox-nav { font-size: 2rem; padding: 15px; }
            .lightbox-prev { left: 5px; }
            .lightbox-next { right: 5px; }
            .lightbox-close { top: 15px; right: 20px; font-size: 1.8rem; }
        }

        @media (max-width: 480px) {
            .gallery-grid { grid-template-columns: 1fr; }
        }
    </style>

    <main>
        <h1 class="page-title">Galería</h1>
        <p class="page-subtitle">Momentos de nuestra historia</p>

        <div class="tags-container" id="tagsContainer">
            <span class="tag active" data-filter="todos">Todos</span>
            {albums.map((album) => (
                <span class="tag" data-filter={album}>{album}</span>
            ))}
        </div>

        <div class="gallery-grid" id="galleryGrid">
            {photos.map((photo, index) => (
                <div class="gallery-item" data-index={index}>
                    <img src={miniatura(photo.foto)} alt={photo.descripcion || photo.album} loading="lazy" decoding="async">
                    <div class="gallery-item-info">
                        <h4>{photo.album}</h4>
                        <p>{photo.fecha}</p>
                    </div>
                </div>
            ))}
            <div class="no-results" id="noResults" hidden>No hay fotos disponibles</div>
        </div>
    </main>

    <!-- LIGHTBOX -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lightboxClose" aria-label="Cerrar">&times;</button>
        <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Anterior">&lsaquo;</button>
        <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Siguiente">&rsaquo;</button>

        <div class="lightbox-content">
            <img class="lightbox-image" id="lightboxImage" src="" alt="" decoding="async">
            <div class="lightbox-info">
                <p class="lightbox-album" id="lightboxAlbum"></p>
                <p class="lightbox-description" id="lightboxDescription"></p>
            </div>
        </div>
    </div>

    <script define:vars={{ photos }}>
        document.addEventListener('DOMContentLoaded', () => {
            // ===== Variables =====
            let filteredPhotos = [];
            let currentAlbum = 'todos';
            let currentIndex = 0;

            const tags = document.querySelectorAll('.tag');
            const items = Array.from(document.querySelectorAll('.gallery-item'));
            const noResults = document.getElementById('noResults');

            // Lightbox elements
            const lightbox = document.getElementById('lightbox');
            const lightboxImage = document.getElementById('lightboxImage');
            const lightboxAlbum = document.getElementById('lightboxAlbum');
            const lightboxDescription = document.getElementById('lightboxDescription');
            const lightboxClose = document.getElementById('lightboxClose');
            const lightboxPrev = document.getElementById('lightboxPrev');
            const lightboxNext = document.getElementById('lightboxNext');

            // ===== Render de fotos =====
            function renderGallery() {
                filteredPhotos = [];

                items.forEach(item => {
                    const photo = photos[Number(item.dataset.index)];
                    const visible = currentAlbum === 'todos' || photo.album === currentAlbum;

                    item.hidden = !visible;
                    if (visible) filteredPhotos.push(photo);
                });

                noResults.hidden = filteredPhotos.length > 0;
            }

            // ===== Lightbox =====
            function openLightbox(index) {
                currentIndex = index;
                updateLightbox();
                lightbox.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            function updateLightbox() {
                const photo = filteredPhotos[currentIndex];
                if (!photo) return;
                lightboxImage.src = photo.foto;
                lightboxImage.alt = photo.descripcion || photo.album;
                lightboxAlbum.textContent = photo.album + ' · ' + photo.fecha;
                lightboxDescription.textContent = photo.descripcion || '';
            }

            function closeLightbox() {
                lightbox.classList.remove('active');
                document.body.style.overflow = '';
            }

            function nextPhoto() {
                currentIndex = (currentIndex + 1) % filteredPhotos.length;
                updateLightbox();
            }

            function prevPhoto() {
                currentIndex = (currentIndex - 1 + filteredPhotos.length) % filteredPhotos.length;
                updateLightbox();
            }

            lightboxClose.addEventListener('click', closeLightbox);
            lightboxNext.addEventListener('click', (e) => { e.stopPropagation(); nextPhoto(); });
            lightboxPrev.addEventListener('click', (e) => { e.stopPropagation(); prevPhoto(); });
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) closeLightbox();
            });

            document.addEventListener('keydown', (e) => {
                if (!lightbox.classList.contains('active')) return;
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowRight') nextPhoto();
                if (e.key === 'ArrowLeft') prevPhoto();
            });

            // ===== Eventos de fotos =====
            items.forEach(item => {
                item.addEventListener('click', () => {
                    const photo = photos[Number(item.dataset.index)];
                    openLightbox(filteredPhotos.indexOf(photo));
                });
            });

            // ===== Filtros =====
            tags.forEach(tag => {
                tag.addEventListener('click', () => {
                    tags.forEach(t => t.classList.remove('active'));
                    tag.classList.add('active');
                    currentAlbum = tag.getAttribute('data-filter');
                    renderGallery();
                });
            });

            renderGallery();
        });
    </script>
</Layout>
