<script>
  import {
    TOURNAMENT_STATUS_CLASSES,
    formatDiasHasta,
    getBoliviaDateKey,
    getDiasHasta,
    resolveStatus
  } from '../lib/torneoStatus.js';

  document.addEventListener('DOMContentLoaded', () => {
    const todayKey = getBoliviaDateKey();

    document.querySelectorAll('.news-card[data-fecha]').forEach((card) => {
      const torneo = {
        fecha: card.dataset.fecha,
        estado: card.dataset.estado
      };
      const status = resolveStatus(torneo);
      const diasHasta = getDiasHasta(card.dataset.fecha, todayKey);

      card.classList.remove(...TOURNAMENT_STATUS_CLASSES);
      card.classList.add(status.className);

      const badge = card.querySelector('[data-status-badge]');
      if (badge) {
        badge.classList.remove(...TOURNAMENT_STATUS_CLASSES);
        badge.classList.add(status.className);
        badge.textContent = status.label;
      }

      const todayBadge = card.querySelector('[data-today]');
      if (todayBadge) todayBadge.hidden = diasHasta !== 0;

      const daysLabel = card.querySelector('[data-days]');
      if (daysLabel) {
        const showDays = Number.isFinite(diasHasta) && diasHasta > 0;
        daysLabel.hidden = !showDays;
        daysLabel.textContent = showDays ? formatDiasHasta(diasHasta) : '';
      }

      const ctaInscribirme = card.querySelector('[data-cta="inscribirme"]');
      if (ctaInscribirme) ctaInscribirme.hidden = status.key !== 'abierto';
    });
  });
</script>
