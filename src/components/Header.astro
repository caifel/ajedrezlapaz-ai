---
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header>
    <div class="header-logo">
        <a href="/"><img src="/assets/logo-adalp.svg" alt="ADALP Logo" width="114" height="114"></a>
    </div>
    <nav class="desktop-nav">
        <ul>
            <li><a href="/" class={isActive('/') ? 'active' : undefined}>Inicio</a></li>
            <li><a href="/torneos/" class={isActive('/torneos') ? 'active' : undefined}>Torneos</a></li>
            <li><a href="/jugadores/" class={isActive('/jugadores') ? 'active' : undefined}>Jugadores</a></li>
        </ul>
    </nav>
    <button
        class="hamburger"
        id="hamburgerBtn"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobileNav"
    >
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
</header>

<nav class="mobile-nav" id="mobileNav" aria-label="Navegación móvil" aria-hidden="true" inert>
    <button class="close-btn" id="closeBtn" type="button" aria-label="Cerrar menú">&times;</button>
    <ul>
        <li><a href="/" class={isActive('/') ? 'active' : undefined}>Inicio</a></li>
        <li><a href="/torneos/" class={isActive('/torneos') ? 'active' : undefined}>Torneos</a></li>
        <li><a href="/jugadores/" class={isActive('/jugadores') ? 'active' : undefined}>Jugadores</a></li>
    </ul>
</nav>
